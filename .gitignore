# ==========================================
xcuserdata/
*.xcuserdatad/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.xcuserstate

# ==========================================
# Rust & Cargo (Matrix SDK Core)
# ==========================================
target/
**/*.rs.bk

# ==========================================
# Swift Package Manager (SPM)
# ==========================================
.build/
.swiftpm/xcode/
.swiftpm/configuration/
.swiftpm/dependencies/
!Package.resolved

# ==========================================
